{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "services/functions-core",
      "codebase": "functions-core",
      "runtime": "nodejs20"
    },
    {
      "source": "services/cad-bim-parser",
      "codebase": "cad-bim-parser",
      "runtime": "python311"
